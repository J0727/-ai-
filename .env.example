# ============================================================
# 智汇研途 · 环境变量模板
# 使用方法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# ============================================================

# 【必填】DeepSeek API Key
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 【可选】模型名称，默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# 【可选】用户数据目录
#   - 不设置时默认 ~/zhihui-data（Windows 为 C:\Users\<用户名>\zhihui-data）
#   - Docker / 服务器部署建议设置为 /data
# ZHIHUI_DATA_DIR=/data

# 【可选】前端静态文件目录，默认自动定位到仓库的 frontend/
# ZHIHUI_FRONTEND_DIR=/app/frontend

# 【可选】服务监听端口
#   - Docker 部署时由 docker-compose.yml 的 ZHIHUI_PORT 控制对外端口
#   - 想用 http://IP 直接访问（不带 :8000），执行：PORT=80 bash scripts/oracle/deploy.sh
# ZHIHUI_PORT=8000

# 【可选】构建镜像时的 pip 源，国内建议换成清华源
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ------------------------------------------------------------
# 数据备份到 Oracle 对象存储（可选，仅 scripts/oracle/backup-to-oci.sh 使用）
# 连接信息由 scripts/oracle/setup-rclone-oci.sh 交互式写入 ~/.config/rclone/rclone.conf
# 这里只放脚本参数：
# OCI_REMOTE=oci              # rclone 远端名
# OCI_BUCKET=zhihui-backups   # 存储桶名
# KEEP=14                     # 云端保留天数
# ------------------------------------------------------------
